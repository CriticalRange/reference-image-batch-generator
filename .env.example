# Required for Auth Method = "API Key" (Gemini Developer API) or "Vertex Express Mode",
# and for non-Vertex Gemini models. Never expose this key to the browser; server-side only.
# - Google AI Studio keys typically start with "AIza"  → Auth Mode: API Key
# - Vertex Express / Cloud keys often start with "AQ." → Auth Mode: Vertex Express Mode
GEMINI_API_KEY=your_api_key_here

# Optional (defaults shown)
GEMINI_IMAGE_MODEL=vertex/gemini-2.5-flash-image
# Vision model for per-reference product analysis (loading-card AI modal)
# GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
MAX_BATCH_SIZE=8
MAX_PARALLEL_REQUESTS=2
MAX_REQUEST_BYTES=16777216
MAX_REFERENCE_IMAGE_BYTES=8388608
MAX_TOTAL_REFERENCE_IMAGE_BYTES=25165824
API_RATE_LIMIT=20
API_RATE_WINDOW_MS=60000
# Optional server-to-server / external API guard. Leave unset for local UI-only development.
# When set, callers must send: Authorization: Bearer <token>
# APP_ACCESS_TOKEN=replace_with_a_long_random_token
# Browser CORS for external websites calling /api/* (comma-separated origins, or *).
# Leave unset for same-origin only. Scripts (curl/node) do not need CORS.
# API_CORS_ORIGINS=https://my-other-site.com,http://localhost:5173
# API_CORS_ORIGINS=*
TOGETHER_API_KEY=your_together_api_key_here
# fal.ai is disabled in this app. Fal-listed models are generated via Vertex service account.
# FAL_AI_API_KEY is ignored if set.
# FAL_AI_API_KEY=unused

# Google Vertex AI — used when Auth Method = "Service Account" (default).
# Choose one credential option.
# Recommended for Vercel: base64-encode the service account JSON file and set this env var.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("free-494923-3c3b6ca698b4.json"))
# VERTEX_AI_CREDENTIALS_BASE64=base64_encoded_service_account_json
VERTEX_AI_CREDENTIALS_PATH=/absolute/path/to/service-account.json
# VERTEX_AI_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Flash-image models force locations/global regardless of this value.
VERTEX_AI_REGION=us-central1
# Optional for Auth Method = Vertex Express Mode (Express project number from 404 paths).
# Do NOT set this to the service-account project (e.g. free-494923).
# VERTEX_EXPRESS_PROJECT=746556696967

