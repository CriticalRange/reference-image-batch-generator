# Required
GEMINI_API_KEY=your_api_key_here

# Optional (defaults shown)
GEMINI_IMAGE_MODEL=vertex/gemini-2.5-flash-image
MAX_BATCH_SIZE=8
MAX_PARALLEL_REQUESTS=2
MAX_REQUEST_BYTES=16777216
MAX_REFERENCE_IMAGE_BYTES=8388608
MAX_TOTAL_REFERENCE_IMAGE_BYTES=25165824
API_RATE_LIMIT=20
API_RATE_WINDOW_MS=60000
# Optional server-to-server API guard. Leave unset for local UI-only development.
# APP_ACCESS_TOKEN=replace_with_a_long_random_token
TOGETHER_API_KEY=your_together_api_key_here
FAL_AI_API_KEY=your_fal_ai_api_key_here

# Google Vertex AI (optional) — choose one of the two credential options
VERTEX_AI_CREDENTIALS_PATH=/absolute/path/to/service-account.json
# VERTEX_AI_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
VERTEX_AI_REGION=us-central1
